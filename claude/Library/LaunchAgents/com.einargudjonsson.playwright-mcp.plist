<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.einargudjonsson.playwright-mcp</string>

    <!-- One shared Playwright MCP server for every Claude session: each client gets its
         own --isolated context, so sessions run in parallel without the profile lock that
         per-session npx instances hit ("Browser is already in use"). The browser launches
         on first tool call; idle cost is one node process.
         Installed with: npm i --prefix ~/.local/share/playwright-mcp @playwright/mcp@0.0.83
         Node is pinned to the fnm install so an fnm default switch can't break the service. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec "$HOME/.local/share/fnm/node-versions/v24.22.0/installation/bin/node" "$HOME/.local/share/playwright-mcp/node_modules/@playwright/mcp/cli.js" --port 8931 --isolated --headless &gt;&gt;"$HOME/.cache/playwright-mcp.log" 2&gt;&amp;1</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
