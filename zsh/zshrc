# Run the gigover Java backend locally (needs JDK 17; local-only, never pushed)
gigback() { cd ~/work/gigover-backend && JAVA_HOME=$(/usr/libexec/java_home -v 17) mvn jetty:run; }

# Pull upstream backend changes from Bitbucket, preserving local edits (never pushes)
gigpull() {
  local d=~/work/gigover-backend
  if [ -n "$(git -C "$d" status --porcelain)" ]; then
    git -C "$d" stash && git -C "$d" pull && git -C "$d" stash pop
  else
    git -C "$d" pull
  fi
}

# =============================================================================
# ZLE widget plugins -- KEEP THIS BLOCK LAST.
#
# Both plugins work by wrapping ZLE widgets, so they must load *after* every
# tool that installs one (fzf, zoxide, atuin, fnm, npm completion above).
# Loading them earlier -- as this file did until now -- leaves the widgets those
# tools add unhighlighted and without suggestions.
#
# Order within the block matters too: the catppuccin theme populates
# ZSH_HIGHLIGHT_STYLES and must be set before syntax-highlighting activates,
# and syntax-highlighting must be the very last thing sourced.
# =============================================================================
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source ~/dotfiles/zsh/catppuccin_mocha-zsh-syntax-highlighting.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
