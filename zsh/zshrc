# --- yazi (terminal file explorer) -------------------------------------------
# Use `y` rather than `yazi`: this wrapper cd's the shell to wherever you
# quit with `q`. Press `Q` to quit *without* changing directory.
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

