# =============================================================================
# zshrc -- interactive shells only.
#
# Anything needed by *every* zsh process (scripts, `zsh -c`, editor subshells)
# belongs in ~/.zshenv instead -- a slow call there taxes the whole machine.
#
# Startup budget: ~110ms. Before adding an `eval "$(tool init zsh)"`, time it;
# anything over ~20ms should be cached to a file (see the hermes/wt blocks).
# Profile with:  PS4=$'+%D{%s.%6.}|%N:%i> ' zsh -ixc exit
#
# ZLE widget plugins (autosuggestions, syntax-highlighting) load at the BOTTOM
# of this file -- they must wrap every widget that other tools add.
# =============================================================================

# --- Completions -------------------------------------------------------------
# Run compinit's security audit (compaudit, ~15ms) at most once per 24h; take
# the `-C` fast path otherwise. See the GOTCHA note by the cache blocks below
# for why this is an array assignment and not `[[ -n ~/.zcompdump(#qN.mh+24) ]]`.
autoload -Uz compinit
_zcompdump_stale=( ~/.zcompdump(N.mh+24) )
if [[ ! -s ~/.zcompdump || -n $_zcompdump_stale ]]; then
  compinit
else
  compinit -C
fi
unset _zcompdump_stale
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache

