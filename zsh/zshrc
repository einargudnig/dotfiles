# >>> conda initialize (lazy loaded for faster shell startup) >>>
conda() {
  unfunction conda
  __conda_setup="$('/opt/anaconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  else
    if [ -f "/opt/anaconda3/etc/profile.d/conda.sh" ]; then
      . "/opt/anaconda3/etc/profile.d/conda.sh"
    else
      export PATH="/opt/anaconda3/bin:$PATH"
    fi
  fi
  unset __conda_setup
  conda "$@"
}
# <<< conda initialize <<<

# fnm (Node version manager). NOT cacheable: `fnm env` mints a per-shell
# multishell symlink dir each run, so a cached copy would break version switching.
eval "$(fnm env --use-on-cd --shell zsh)"

export PATH=$PATH:$HOME/go/bin

# try.rb shell integration (inlined -- `try.rb init` spawns ruby, ~100ms per shell)
# This is the verbatim output of `~/.local/try.rb init`; re-run that if try.rb's init changes.
try() {
  script_path="$HOME/.local/try.rb"
  cmd=$(/usr/bin/env ruby "$script_path" cd --path "$HOME/src/tries" "$@" 2>/dev/tty)
  rc=$?
  if [ $rc -eq 0 ]; then
    case "$cmd" in
      *" && "*) eval "$cmd" ;;
      *) printf %s "$cmd" ;;
    esac
  else
    printf %s "$cmd"
  fi
}


# --- Cached tool integrations ------------------------------------------------
# Pattern: `tool init`/`completion` output is static, so write it once and source
# the file. To force a refresh: rm the cache file and open a new shell.
#
# GOTCHA -- staleness check. `[[ -n file(N.md+14) ]]` looks right but is ALWAYS
# TRUE: [[ ]] never performs filename generation, so the pattern is just a
# non-empty string. The glob must be expanded via an array assignment, and the
# path must be a LITERAL -- zsh does not glob words that came from a parameter
# expansion, so `$cache(N.md+14)` silently fails the same way.
# Qualifier: N = no error if unmatched, .= plain file, md+14 = mtime >14 days.

# Hermes Agent completion (`hermes completion zsh` costs ~240ms uncached)
_stale=( ~/.cache/hermes-completion.zsh(N.md+14) )
if [[ ! -s ~/.cache/hermes-completion.zsh || -n $_stale ]]; then
  mkdir -p ~/.cache
  command -v hermes >/dev/null 2>&1 && hermes completion zsh > ~/.cache/hermes-completion.zsh 2>/dev/null
fi
[[ -s ~/.cache/hermes-completion.zsh ]] && source ~/.cache/hermes-completion.zsh

alias h='hermes chat'
alias hs='hermes status'

# worktrunk shell integration (`wt config shell init` costs ~20ms uncached)
if command -v wt >/dev/null 2>&1; then
  _stale=( ~/.cache/wt-init.zsh(N.md+14) )
  if [[ ! -s ~/.cache/wt-init.zsh || -n $_stale ]]; then
    mkdir -p ~/.cache
    command wt config shell init zsh > ~/.cache/wt-init.zsh 2>/dev/null
  fi
  [[ -s ~/.cache/wt-init.zsh ]] && source ~/.cache/wt-init.zsh
fi
unset _stale
