<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.einargudjonsson.tmux-prune</string>

    <!-- $HOME is expanded by the shell, not launchd: keeps this plist portable
         across machines whose account name differs. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>exec "$HOME/dotfiles/tmux/scripts/tmux-prune.sh" &gt;&gt;"$HOME/.cache/tmux-prune.launchd.log" 2&gt;&amp;1</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TMUX_PRUNE_NOTIFY</key>
        <string>1</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
